  body.menu-open { overflow: hidden; }
}

/* ==========================================================================
   12. AJUSTES MUY PEQUEÑOS (< 360px)
   ========================================================================== */
@media screen and (max-width: 360px) {
  :root {
    --mobile-font-size-title: 28px;
    --mobile-font-size-subtitle: 14px;
    --mobile-font-size-text: 12px;
    --mobile-social-width: 260px;
    --mobile-social-height: 75px;
    --mobile-footer-total-height: calc(75px + 30px);
  }

  .social-card__content img[src*=".svg"] { width: 24px; height: 24px; }
  .social-card__handle { font-size: 12px; max-width: 120px; }
  .social-card__label  { font-size: 14px; top: -24px; padding: 2px 8px; }
  .ig-post             { max-width: 300px !important; }
  .captcha-card        { max-width: 270px !important; }

  .contact-expanded-mobile {
    width: calc(100% - 24px) !important;
    max-width: none !important;
    margin: 0 auto 20px auto !important;
  }
}

/* ==========================================================================
   13. GARANTIZAR SEPARACIÓN EN MÓVIL
   ========================================================================== */
@media screen and (max-width: 768px) {
  .content-stack-inner > *:last-child { margin-bottom: 20px !important; }
  .layout.contact-active .content-stack-inner > *:last-child { margin-bottom: 0 !important; }
  .layout { padding-bottom: calc(100px) !important; }
  /* En contact no necesitamos padding extra del layout */
  .layout.contact-active { padding-bottom: 0 !important; }
}

/* ==========================================================================
   14. COMPORTAMIENTOS TÁCTILES
   ========================================================================== */
@media screen and (max-width: 768px) {
  body {
    overscroll-behavior: auto;
    -webkit-overflow-scrolling: touch;
  }

  .layout { touch-action: pan-y; }
  .layout[data-section] { transition: none !important; }
}

/* ==========================================================================
   15. TILT EN MÓVIL
   ========================================================================== */
@media screen and (max-width: 1024px) {
  .ig-post,
  .captcha-card {
    transform: none;
    transition: transform 0.05s linear;
  }
}
/* ==========================================================================
   SELECTOR DE IDIOMA - RESPONSIVE
   ========================================================================== */
@media screen and (max-width: 768px) {
  .lang-selector {
    margin-left: 12px;
    font-size: 12px;
  }
  .lang-btn {
    padding: 2px 4px;
  }
}

@media screen and (max-width: 480px) {
  .lang-selector {
    margin-left: 8px;
    font-size: 11px;
    gap: 4px;
  }
  .lang-btn {
    padding: 2px 3px;
  }
}

/* ==========================================================================
   NUEVO: OCULTAR BOTONES EN MÓVIL Y BANDERA CLICKEABLE
   ========================================================================== */
@media screen and (max-width: 768px) {
  .lang-btn,
  .lang-divider {
    display: none;
  }
  .lang-flag {
    cursor: pointer;
    padding: 4px;
    font-size: 18px;
  }
}

/* ==========================================================================
   BLOQUE DE SERVICIOS EN MÓVIL (fuera de la card)
   ========================================================================== */
.contact-services-mobile {
  width: 100%;
  max-width: 480px;
  margin: 0 auto 16px auto;
  padding: 0 10px;
}

.contact-services-mobile .contact-services {
  border-bottom: 1px solid rgba(59,130,246,0.15);
  padding-bottom: 12px;
  margin-bottom: 0;
}

.contact-services-mobile .contact-service-item {
  margin-bottom: 4px;
}

.contact-services-mobile .contact-service-item:last-child {
