  .captcha-subtitle  { font-size: 10.45px; }

  .captcha-card .captcha-footer {
    padding: 4px 10px !important;
    background-color: var(--bg-card) !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0;
    border-top: 1px solid var(--bg-subtle) !important;
