  right: -4px;
  width: auto;
  min-width: 0;
  padding: 4px 12px;
  background-color: var(--primary-color);
  color: #fff;
  font-family: "Inter", sans-serif;
  font-size: 18px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: -0.05em;
  z-index: 10;
  pointer-events: none;
  box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  white-space: nowrap;
  border-radius: 0;
}

.social-card__content {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14px;
  font-family: "Azeret Mono", monospace;
  font-weight: 500;
  height: 100%;
  position: relative;
  z-index: 10;
}

.social-card__content a {
  color: var(--accent-blue);
  font-size: 35px;
  text-decoration: none;
  position: relative;
  z-index: 20;
  transition: transform 0.2s ease;
}

.social-card__content a:hover { transform: translateY(-3px); }

.social-card__handle {
  color: var(--accent-blue);
  font-size: 16px;
  position: relative;
  z-index: 20;
}

/* ==========================================================================
   SOCIAL CARD EXPANDED (Contact)
   ========================================================================== */
.contact-expanded-instance {
  position: fixed;
  z-index: 10000;
  pointer-events: auto;
  overflow: visible !important;
}

.contact-expanded-instance a { pointer-events: auto; }

.contact-expanded-instance .social-card {
  width: 100% !important;
  height: 100% !important;
  padding: 0 !important;
  border: 4px solid var(--primary-color) !important;
  background: var(--bg-card) !important;
  position: relative !important;
  box-sizing: border-box !important;
  overflow: visible !important;
  box-shadow: 0 0 40px rgba(59, 130, 246, 0.2) !important;
}

.contact-expanded-instance .social-card__inner {
  position: relative !important;
  width: 100% !important;
  height: 100% !important;
  padding: 16px 10px 10px 10px !important; /* Aumentado el padding superior */
  background: var(--bg-card) !important;
  box-sizing: border-box !important;
  display: flex !important;
  flex-direction: column !important;
  z-index: 5 !important;
  overflow: visible !important;
}

.contact-expanded-instance .social-card__label {
  position: absolute !important;
  top: -32px !important;
  right: -4px !important;
  width: auto !important;
  min-width: 0 !important;
