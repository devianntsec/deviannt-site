/* ==========================================================================
   7. CONTACT MÓVIL — card expandida en flujo, justo después del subtítulo
   ========================================================================== */
@media screen and (max-width: 768px) {
  .layout.contact-active .ig-post,
  .layout.contact-active .projects-captcha { display: none !important; }

  .layout.contact-active .layout-left { display: none !important; }

  .layout-right.is-contact {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 100vh !important;
    padding: 20px 20px 120px !important; /* antes: 40px 20px 120px */
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    align-items: center !important;
    background: transparent !important;
    top: auto !important;
    left: auto !important;
    z-index: 30 !important;
    pointer-events: auto !important;
  }

  .layout-right.is-contact .content-stack {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    transform: none !important;
    width: 100% !important;
    max-width: 600px !important;
    margin: 0 auto !important;
    padding: 0 !important;
  }

  .layout-right.is-contact .content-stack-inner {
    min-height: auto !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    width: 100%;
    padding-bottom: 60px !important;
  }

  .layout-right.is-contact .title-select {
    font-size: 32px !important;
    padding: 0 10px !important;
    margin: 0 0 15px 0 !important;
    text-align: center !important;
    color: var(--text-primary) !important;
  }

  .layout-right.is-contact .subtitle {
    font-size: var(--mobile-font-size-subtitle) !important;
    margin: 0 0 25px 0 !important;
    text-align: center !important;
    width: 100%;
    color: var(--accent-blue) !important;
  }

  .layout-right.is-contact .description,
  .layout-right.is-contact .description--indented { display: none !important; }

  /* ── CARD EXPANDIDA INLINE (móvil contact) ── */
  .contact-expanded-mobile {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    transform: none !important;
    /* Ocupa todo el ancho menos márgenes */
    width: calc(100% - 40px) !important;
    max-width: 480px !important;
    height: auto !important;
    min-height: 180px !important;
    /* ── DISTANCIA ENTRE SUBTÍTULO Y CARD ───────────────────────────────
       Este margin-top empuja la card hacia abajo, alejándola del subtítulo
       y dando sensación de centrado vertical en pantalla.
       Valor actual: 40px. Ajusta manualmente si necesitas más/menos espacio.
       ─────────────────────────────────────────────────────────────────── */
    margin-top: 40px !important;
    /* Centrado horizontal */
    margin-right: auto !important;
    margin-left: auto !important;
    margin-bottom: 30px !important;
    display: block !important;
    z-index: 10 !important;
    pointer-events: auto !important;
    animation: none !important;
    box-sizing: border-box !important;
    /* Sin float-natural: no tiene sentido en flujo */
    float: none !important;
  }

  /* Aseguramos que el social-card dentro tenga borde correcto */
  .contact-expanded-mobile .social-card {
    width: 100% !important;
    height: auto !important;
    min-height: 160px !important;
    border: 4px solid var(--primary-color) !important;
    background: var(--bg-card) !important;
    box-sizing: border-box !important;
    position: relative !important;
    box-shadow: 0 0 30px rgba(59, 130, 246, 0.15) !important;
  }

  .contact-expanded-mobile .social-card__inner {
    width: 100% !important;
    height: auto !important;
    /* ── PADDING INTERNO DE LA CARD ─────────────────────────────────────
       Controla el espacio interior de la card expandida en móvil.
       Valor actual: 28px 20px 20px. Ajusta manualmente si lo necesitas.
       ─────────────────────────────────────────────────────────────────── */
    padding: 28px 20px 20px !important;
    background: var(--bg-card) !important;
    box-sizing: border-box !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    overflow: visible !important;
  }

  .contact-expanded-mobile .social-card__label {
    top: -28px !important;
    font-size: 16px !important;
    padding: 4px 12px !important;
    background-color: var(--primary-color) !important;
    right: -4px !important;
  }

  .contact-expanded-mobile .social-card__content {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    height: auto !important;
  }

  .contact-expanded-mobile .contact-grid-expanded {
    gap: 14px !important;
    width: 100% !important;
  }

  .contact-expanded-mobile .contact-row-expanded {
    gap: 20px !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
  }

  .contact-expanded-mobile .contact-icon-item-expanded {
    min-width: 50px !important;
  }

  .contact-expanded-mobile .contact-icon-wrapper-expanded {
    width: 40px !important;
    height: 40px !important;
  }

  .contact-expanded-mobile .contact-icon-svg-expanded {
    width: 36px !important;
    height: 36px !important;
  }

  .contact-expanded-mobile .contact-icon-text-expanded {
    font-size: 11px !important;
    color: var(--accent-blue) !important;
  }
}

/* ==========================================================================
   8. AJUSTES GENERALES MÓVIL
   ========================================================================== */
@media screen and (max-width: 768px) {
  .title-select::before,
  .title-select::after {
    top: 3px !important;
    bottom: 3px !important;
    height: calc(100% - 6px) !important;
  }

  .layout-right.is-projects .title-select::before,
  .layout-right.is-projects .title-select::after,
  .layout-right.is-blog .title-select::before,
  .layout-right.is-blog .title-select::after,
  .layout-right.is-contact .title-select::before,
  .layout-right.is-contact .title-select::after,
  .layout:not(.projects-active):not(.blog-active):not(.contact-active) .title-select::before,
  .layout:not(.projects-active):not(.blog-active):not(.contact-active) .title-select::after {
    top: 3px !important;
    bottom: 3px !important;
    height: calc(100% - 6px) !important;
  }

  .title-select {
    font-size: var(--mobile-font-size-title) !important;
    padding: 0 15px !important;
    margin-bottom: 15px !important;
    line-height: 1.2 !important;
    color: var(--text-primary) !important;
  }

  .title-select span {
    font-size: var(--mobile-font-size-title) !important;
    line-height: 1.2 !important;
    display: inline-block;
    vertical-align: middle;
  }

  .title-select .line.left {
    top: -4px !important;
    bottom: -4px !important;
    height: calc(100% - 0px) !important;
    width: 3px;
    background: var(--primary-color) !important;
  }

  .title-select .line.right {
    top: 1px !important;
    bottom: -9px !important;
    height: calc(100% - 8px) !important;
    width: 3px;
    background: var(--primary-color) !important;
  }

  .title-select .dot-left,
  .title-select .dot-right {
    width: 10px;
    height: 10px;
    background: var(--primary-color) !important;
  }

  .title-select .dot-left {
    top: -5px;
    left: 2px;
    transform: translateX(-50%);
  }

  .title-select .dot-right {
    bottom: -2px;
    right: -10px;
    transform: translateX(0%);
  }

  @keyframes dot-right-grow-mobile {
    0%   { right: calc(90%); transform: translateX(0%); }
    100% { right: 0; transform: translateX(30%); }
  }

  .title-select.animate .dot-right  { animation: dot-right-grow-mobile 1s forwards !important; }
  .title-select.animate .line.right { animation: line-right-grow 1s forwards !important; }

  #connector-layer,
  #connection-path,
  .description--indented::before,
  .projects-links-wrapper::before { display: none !important; }

   /* Waves en móvil - Más alargadas horizontalmente */
  #bg-wave {
    position: fixed !important;
    bottom: 0 !important;
    right: 0 !important;
    width: 130vw !important;
    height: 20vh !important;
    opacity: 0.2 !important;
    mask-image: radial-gradient(circle at bottom right,
      rgba(0,0,0,1) 0%,
      rgba(0,0,0,0.85) 40%,
      rgba(0,0,0,0.4) 65%,
      rgba(0,0,0,0) 85%) !important;
    -webkit-mask-image: radial-gradient(circle at bottom right,
      rgba(0,0,0,1) 0%,
      rgba(0,0,0,0.85) 40%,
      rgba(0,0,0,0.4) 65%,
      rgba(0,0,0,0) 85%) !important;
  }

  #bg-wave-tl {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 130vw !important;
    height: 20vh !important;
    opacity: 0.2 !important;
    mask-image: radial-gradient(circle at top left,
      rgba(0,0,0,1) 0%,
      rgba(0,0,0,0.85) 40%,
      rgba(0,0,0,0.4) 65%,
      rgba(0,0,0,0) 85%) !important;
    -webkit-mask-image: radial-gradient(circle at top left,
      rgba(0,0,0,1) 0%,
      rgba(0,0,0,0.85) 40%,
      rgba(0,0,0,0.4) 65%,
      rgba(0,0,0,0) 85%) !important;
  }

  body {
    overflow-x: hidden;
    overflow-y: auto;
    background: var(--bg-base) !important;
  }

  * {
    animation-duration: 0.3s !important;
    transition-duration: 0.3s !important;
  }

  a, button, .captcha-cell, .social-card__content a {
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  input, select, textarea { font-size: 16px; }

  .layout[data-section="deviannt"] .ig-post        { display: block !important; }
  .layout[data-section="deviannt"] .projects-captcha { display: none !important; }
  .layout[data-section="projects"] .ig-post        { display: none !important; }
  .layout[data-section="projects"] .projects-captcha { display: flex !important; }
  .layout[data-section="blog"] .ig-post,
  .layout[data-section="blog"] .projects-captcha   { display: none !important; }
  .layout[data-section="contact"] .ig-post,
  .layout[data-section="contact"] .projects-captcha { display: none !important; }
}

