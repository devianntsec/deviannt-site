<file path="css/components.css">
/* ==========================================================================
   COMPONENTS.CSS - Versión DARK THEME
   ========================================================================== */

/* ==========================================================================
   1. NAVBAR
   ========================================================================== */
nav {
  padding: 24px 80px;
  display: flex;
  justify-content: flex-end;
  position: relative;
  z-index: 1000;
  background: transparent;
}

.navbar {
  position: relative;
  display: flex;
  gap: 32px;
  width: fit-content;
}

.navbar a {
  position: relative;
  padding: 4px 0;
  text-decoration: none;
  color: var(--text-primary);
  font-size: 1.2em;
  font-weight: 500;
  transition: color 0.2s ease;
}

.navbar a:hover {
  color: var(--accent-blue);
}

.selector {
  position: absolute;
  bottom: -6px;
  left: 0;
  height: 2px;
  width: 0;
  background-color: var(--accent-blue);
  transform: translateX(0);
  transition: transform 0.35s var(--transition-bezier),
              width   0.35s var(--transition-bezier);
}

/* ==========================================================================
   2. LAYOUT PRINCIPAL
   ========================================================================== */
.layout {
  display: flex;
  width: 100vw;
  height: calc(100vh - var(--nav-height)); /* antes: calc(100vh - 96px) — centralizado en :root */
}

.layout-left {
  width: 50%;
  position: relative;
}

.layout-right {
  position: relative;
  width: 45%;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  transition: justify-content 0.6s ease;
  isolation: isolate;
  z-index: 30;
  transform: translateZ(0);
}

.will-animate {
  will-change: transform;
}

.layout-right * { isolation: isolate; }

.content-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding-top: var(--title-top); /* ← ancla única y compartida entre secciones */
  transition: transform 0.6s var(--transition-bezier),
              align-items 0.6s ease;
  z-index: 40;
}

.content-stack-inner {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 380px;
  z-index: 41;
}

/* Projects alignment */
.layout-right.is-projects {
  justify-content: flex-start;
  padding-left: 0;
}

.layout-right.is-projects .content-stack {
  transform: translateX(-150px); 
  align-items: flex-start;
  width: 100%;
  max-width: 800px;
  /* padding-top heredado de .content-stack: mismo anclaje que el resto */
}

.layout-right.is-projects .content-stack-inner {
  align-items: flex-start !important;
  min-height: 380px;
  width: 100%;
}

.layout-right.is-projects .title-select,
.layout-right.is-projects .subtitle,
.layout-right.is-projects .description,
.layout-right.is-projects .description--indented {
  text-align: left !important;
  justify-content: flex-start !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  width: 100% !important;
}

.layout-right.is-projects .title-select {
  justify-content: flex-start !important;
  text-align: left !important;
  margin-left: 0 !important;
  padding-left: 25px !important;
  padding-right: 25px !important;
  width: 100% !important;
}

.layout-right.is-projects .title-select span {
  text-align: left !important;
  display: block !important;
  width: 100% !important;
}

.layout-right.is-projects .subtitle {
  justify-content: flex-start !important;
  text-align: left !important;
  width: 100% !important;
  margin-left: 0 !important;
}

.layout-right.is-projects .subtitle .typed-text {
  text-align: left !important;
  display: inline-block !important;
  width: auto !important;
}

.layout-right.is-projects .description {
  text-align: left !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  width: 100% !important;
  max-width: 600px !important;
}

.layout-right.is-projects .description--indented {
  width: 100% !important;
  max-width: 600px !important;
  padding-left: 35px !important;
  text-align: left !important;
  margin-left: 0 !important;
}

.layout-right.is-projects .description--indented::before {
  left: 0 !important;
}

/* ==========================================================================
   3. TIPOGRAFÍA - DARK THEME
   ========================================================================== */
.title-select {
  position: relative;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  margin-top: 0;
  margin-bottom: 20px;
  padding: 0 25px;
  font-family: "Azeret Mono", monospace;
  font-size: 64px;
  font-weight: 500;
  text-transform: uppercase;
  color: #E2E8F0;
  line-height: 1.1;
  width: auto;
  max-width: max-content;
}

.title-select span {
  position: relative;
  z-index: 2;
  letter-spacing: -0.10em;
  line-height: 1.1;
  display: inline-block;
}

/* Highlight layers */
.title-select::before,
.title-select::after {
  content: "";
  position: absolute;
  top: 8px;
  bottom: 8px;
  left: 0;
  right: 0;
  border-radius: 2px;
  width: 100%;
  height: calc(100% - 16px);
  box-sizing: border-box;
}

.title-select::before {
  background: rgba(59, 130, 246, 0.18);
  z-index: 1;
}

.title-select::after {
  background: rgba(59, 130, 246, 0.30);
  z-index: 2;
  transform: scaleX(0);
  transform-origin: 0% 50%;
}

.title-select.animate::before { opacity: 0; }
.title-select.animate::after  { animation: highlight-grow 1s forwards; }

/* Líneas decorativas */
.title-select .line {
  position: absolute;
  width: 4px;
  background: var(--primary-color);
  z-index: 3;
}

.title-select .line.left {
  left: 0;
  top: -4px;
  bottom: -4px;
  height: calc(100% - 0px);
}

.title-select .line.right {
  right: 0;
  top: 1px;
  bottom: -9px;
  height: calc(100% - 8px);
}

/* Puntos decorativos */
.title-select .dot-left,
.title-select .dot-right {
  position: absolute;
  width: 16.5px;
  height: 16.5px;
  background: var(--primary-color);
  border-radius: 50%;
  z-index: 4;
}

.title-select .dot-left {
  top: -9px;
  left: 2px;
  transform: translateX(-50%);
}

.title-select .dot-right {
  bottom: -9px;
  right: 0px;
  margin-left: -15px;
  transform: translateX(50%);
}

.title-select.animate .line.right  { animation: line-right-grow 1s forwards; z-index: 5; }
.title-select.animate .dot-right   { animation: dot-right-grow 1s forwards;  z-index: 6; }

/* Unificar highlight en todas las secciones */
.layout-right.is-projects .title-select::before,
.layout-right.is-projects .title-select::after,
.layout-right.is-blog .title-select::before,
.layout-right.is-blog .title-select::after,
.layout-right.is-contact .title-select::before,
.layout-right.is-contact .title-select::after,
.layout:not(.projects-active):not(.blog-active):not(.contact-active) .title-select::before,
.layout:not(.projects-active):not(.blog-active):not(.contact-active) .title-select::after {
  top: 8px !important;
  bottom: 8px !important;
  height: calc(100% - 16px) !important;
}

.layout-right.is-projects .title-select .line.left,
.layout-right.is-blog .title-select .line.left,
.layout-right.is-contact .title-select .line.left,
.layout:not(.projects-active):not(.blog-active):not(.contact-active) .title-select .line.left {
  top: -4px !important;
  bottom: -4px !important;
  height: calc(100% - 0px) !important;
}

.layout-right.is-projects .title-select .line.right,
.layout-right.is-blog .title-select .line.right,
.layout-right.is-contact .title-select .line.right,
.layout:not(.projects-active):not(.blog-active):not(.contact-active) .title-select .line.right {
  top: 1px !important;
  bottom: -9px !important;
  height: calc(100% - 8px) !important;
}

/* Subtitle */
.subtitle {
  margin-top: 0;
  margin-bottom: 25px;
  display: flex;
  justify-content: center;
  font-family: "Azeret Mono", monospace;
  font-size: 22.5px;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--accent-blue);
  width: 100%;
  text-align: center;
}

.subtitle .cursor {
  display: inline-block;
  width: 2.2px;
  height: 1em;
  background-color: var(--accent-blue);
  margin-top: 6px;
  margin-left: 5px;
  animation: blink 0.9s infinite;
}

/* Description */
.description {
  margin: 0;
  margin-top: 10px;
  max-width: 600px;
  font-family: "JetBrains Mono", monospace;
  font-size: 18px;
  font-weight: 200;
  line-height: 1.7;
  letter-spacing: -0.05em;
  text-align: center;
  color: var(--text-primary);
}

.description .name { font-weight: 900; color: var(--accent-blue); }

.description--indented:not(.projects-links-mode) {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.description--indented {
  width: 78%;
  position: relative;
  padding-left: 35px;
  margin-top: 30px;
  margin-bottom: 0;
  color: var(--text-primary);
}

.description--indented::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.85em;
  width: 20px;
  height: 2.5px;
  background-color: var(--secondary-color);
}

.description--indented[style*="display: none"] { display: none !important; }

.description--indented.projects-links-mode[style*="display: none"] {
  display: none !important;
  margin: 0 !important;
  padding: 0 !important;
  min-height: 0 !important;
  height: 0 !important;
  overflow: hidden !important;
}

/* ==========================================================================
   4. SOCIAL CARD - Normal
   ========================================================================== */
.social-wrapper {
  position: absolute;
  bottom: 32px;
  right: 497px;
  width: 250px;
  height: 80px;
  z-index: 100;
  animation: float-natural 6s ease-in-out infinite;
  transition: left 0.8s var(--transition-bezier);
  /* antes: will-change: left permanente — quitado, ver .will-animate */
}

.social-wrapper.position-about   { left: -55px; }
.social-wrapper.position-projects { left: calc(65%); }
.social-wrapper.position-blog    { opacity: 1; }
.social-wrapper.no-transition    { transition: none !important; }

.social-card {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 0;
  border: 4px solid var(--primary-color);
  background: var(--bg-card);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: visible;
  box-shadow: var(--shadow-glow);
}

.social-card__inner {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 10px 0 10px 10px;
  background: var(--bg-card);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  z-index: 5;
  overflow: visible;
}

.social-card__label {
  position: absolute;
