// ===========================
// TILT EFFECT - VERSIÓN CON PAUSA SUAVE EN SCROLL
// + PAUSA POR VISIBILIDAD DE PESTAÑA Y VIEWPORT (optimización batería/CPU)
// ===========================

const tiltEffect = {
  intervals: {
    igPost: null,
    captcha: null
  },
  angles: {
    igPost: 0,
    captcha: 2  // El +2 que tenías antes
  },
  isScrolling: false,
  scrollTimeout: null,

  // ===========================
  // OPTIMIZACIÓN: estado de visibilidad global (pestaña) y por-elemento
  // (viewport). Los loops de animación consultan estos flags en cada
  // iteración; si cualquiera es false, se salta el trabajo de cálculo/
  // pintado pero el loop sigue vivo (para reanudar sin reinicializar).
  // ===========================
  isPageVisible: true,
  elementsVisible: {
    igPost: true,
    captcha: true
  },
  observers: [],

  prefersReducedMotion: false,

  init() {
    const isMobile = window.innerWidth <= 1024;
    this.prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

    // Limpiar intervals anteriores
    this.clearIntervals();
    this._teardownObservers();

    this.isPageVisible = !document.hidden;
    this._setupVisibilityListener();
    this._setupIntersectionObservers();

    if (this.prefersReducedMotion) {
      if (!isMobile) {
        // Se mantiene el tilt que responde al mouse (gesto activo del
        // usuario, no autoplay) pero sin el idle loop que rota solo.
        this.startDesktopTilt($(".ig-post"), 'igPost', { autoRotate: false });
        this.startDesktopTilt($(".captcha-card"), 'captcha', { autoRotate: false });
      }
      // En mobile no hay hover posible, así que queda estático sin más.
      return;
    }

    if (isMobile) {
      this.startMobileAnimation();
      this.setupScrollListener();
    } else {
      this.startDesktopTilt($(".ig-post"), 'igPost');
      this.startDesktopTilt($(".captcha-card"), 'captcha');
    }

    this.setupResizeListener();
  },

  // ===========================
  // Pausa global cuando la pestaña no está visible
  // ===========================
  _setupVisibilityListener() {
    if (this._visibilityHandler) {
      document.removeEventListener('visibilitychange', this._visibilityHandler);
    }
    this._visibilityHandler = () => {
      this.isPageVisible = !document.hidden;
    };
    document.addEventListener('visibilitychange', this._visibilityHandler);
  },

  // ===========================
  // Pausa por elemento cuando sale del viewport (p.ej. el usuario está
  // en la sección "projects" y el ig-post está oculto/fuera de pantalla)
  // ===========================
  _setupIntersectionObservers() {
    const igPost = $('.ig-post');
    const captcha = $('.captcha-card');

    if (igPost) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          this.elementsVisible.igPost = entry.isIntersecting;
        });
      }, { threshold: 0.01 });
      obs.observe(igPost);
      this.observers.push(obs);
    }

    if (captcha) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          this.elementsVisible.captcha = entry.isIntersecting;
        });
      }, { threshold: 0.01 });
      obs.observe(captcha);
      this.observers.push(obs);
    }
  },

  _teardownObservers() {
    this.observers.forEach(obs => obs.disconnect());
    this.observers = [];
  },

  clearIntervals() {
    if (this.intervals.igPost) {
      clearInterval(this.intervals.igPost);
      this.intervals.igPost = null;
    }
    if (this.intervals.captcha) {
      clearInterval(this.intervals.captcha);
      this.intervals.captcha = null;
    }
  },

  startMobileAnimation() {
    const igPost = $('.ig-post');
    const captcha = $('.captcha-card');
    
    if (!igPost || !captcha) {
      return;
    }
    
    // Resetear ángulos si es necesario
    this.angles.igPost = 0;
    this.angles.captcha = 2;
    
    // Guardar referencia a this para usar en los callbacks
    const self = this;
    
    // ANIMACIÓN PARA IG POST
    this.intervals.igPost = setInterval(() => {
      // OPTIMIZACIÓN: pausa si la pestaña no está visible o el elemento
      // está fuera del viewport — no se calcula ni se pinta nada.
      if (!self.isPageVisible || !self.elementsVisible.igPost) return;

      // Si está scrolleando, solo actualizar el ángulo pero no aplicar transform
      if (self.isScrolling) {
        self.angles.igPost += 0.03;
        return;
      }
      
      const px = 0.5 + 0.4 * Math.cos(self.angles.igPost);
      const py = 0.5 + 0.4 * Math.sin(self.angles.igPost);
      const tiltX = 10 - px * 20;
      const tiltY = py * 20 - 10;
      
      igPost.style.transform = `perspective(1000px) rotateX(${tiltY}deg) rotateY(${tiltX}deg) scale(1.07)`;
      
      self.angles.igPost += 0.03;
    }, 40);

    // ANIMACIÓN PARA CAPTCHA
    this.intervals.captcha = setInterval(() => {
      if (!self.isPageVisible || !self.elementsVisible.captcha) return;

      // Si está scrolleando, solo actualizar el ángulo pero no aplicar transform
      if (self.isScrolling) {
        self.angles.captcha += 0.03;
        return;
      }
      
      const px = 0.5 + 0.4 * Math.cos(self.angles.captcha);
      const py = 0.5 + 0.4 * Math.sin(self.angles.captcha);
      const tiltX = 10 - px * 20;
      const tiltY = py * 20 - 10;
      
      captcha.style.transform = `perspective(1000px) rotateX(${tiltY}deg) rotateY(${tiltX}deg) scale(1.07)`;
      
      self.angles.captcha += 0.03;
    }, 40);
  },

  setupScrollListener() {
    const self = this;
    
    window.addEventListener('scroll', () => {
      // Si no estaba scrolleando, marcamos inicio
      if (!self.isScrolling) {
        self.isScrolling = true;
      }
      
      // Limpiar timeout anterior
      if (self.scrollTimeout) {
        clearTimeout(self.scrollTimeout);
      }
      
      // Programar fin del scroll
      self.scrollTimeout = setTimeout(() => {
        self.isScrolling = false;
      }, 100);
      
    }, { passive: true });
  },

  startDesktopTilt(element, elementKey, options = {}) {
    if (!element) return;
    const enableAutoRotate = options.autoRotate !== false;
    
    const CONFIG = {
      MAX_TILT: 20,
      PERSPECTIVE: 1000,
      SCALE: 1.07,
      SPEED: 300,
      AUTO_ROTATE_RADIUS: 0.4,
      AUTO_ROTATE_SPEED: 0.005
    };
    
    let angle = 0;
    let isHover = false;
    let animationFrame;
    const self = this;
    
    element.style.transformStyle = "preserve-3d";
    
    const addTransition = () => {
      element.classList.add("tilt-transition");
      clearTimeout(element._tt);
      element._tt = setTimeout(() => {
        element.classList.remove("tilt-transition");
      }, CONFIG.SPEED);
    };
    
    const notifyConnectionLine = () => {
      if (window.connectionLine && element.classList.contains('ig-post')) {
        setTimeout(() => window.connectionLine.update(true), 10);
      }
    };
    
    const updateTransform = (px, py) => {
      const tiltX = CONFIG.MAX_TILT / 2 - px * CONFIG.MAX_TILT;
      const tiltY = py * CONFIG.MAX_TILT - CONFIG.MAX_TILT / 2;
      element.style.transform = `perspective(${CONFIG.PERSPECTIVE}px) rotateX(${tiltY}deg) rotateY(${tiltX}deg) scale(${CONFIG.SCALE})`;
      notifyConnectionLine();
    };
    
    function autoRotate() {
      // OPTIMIZACIÓN: si la pestaña no está visible o el elemento está
      // fuera del viewport, seguimos pidiendo el próximo frame (para no
      // tener que reinicializar el loop) pero sin calcular ni pintar.
      const elVisible = elementKey ? self.elementsVisible[elementKey] : true;
      if (!self.isPageVisible || !elVisible) {
        animationFrame = requestAnimationFrame(autoRotate);
        return;
      }

      if (!isHover) {
        const px = 0.5 + CONFIG.AUTO_ROTATE_RADIUS * Math.cos(angle);
        const py = 0.5 + CONFIG.AUTO_ROTATE_RADIUS * Math.sin(angle);
        updateTransform(px, py);
        angle += CONFIG.AUTO_ROTATE_SPEED;
      }
      animationFrame = requestAnimationFrame(autoRotate);
    }
    if (enableAutoRotate) autoRotate();
    
    element.addEventListener("mouseenter", () => { 
      isHover = true; 
      addTransition();
      // OPTIMIZACIÓN: will-change solo durante la interacción activa,
      // no permanente (ver css/components.css .will-animate)
      element.classList.add('will-animate');
    });
    
    element.addEventListener("mousemove", (e) => {
      const rect = element.getBoundingClientRect();
      const px = (e.clientX - rect.left) / rect.width;
      const py = (e.clientY - rect.top) / rect.height;
      addTransition();
      updateTransform(px, py);
    });
    
    element.addEventListener("mouseleave", () => { 
      isHover = false; 
      addTransition();
      notifyConnectionLine();
      setTimeout(() => element.classList.remove('will-animate'), CONFIG.SPEED);
    });
  },

  setupResizeListener() {
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        
        // Limpiar transforms
        if ($(".ig-post")) $(".ig-post").style.transform = '';
        if ($(".captcha-card")) $(".captcha-card").style.transform = '';
        this.clearIntervals();
        this._teardownObservers();
        
        // Reiniciar
        this.init();
      }, 250);
    });
  }
};

// Inicialización
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => tiltEffect.init());
} else {
  tiltEffect.init();
}

window.tiltEffect = tiltEffect;
</file>

<file path="js/titles.js">
// ===========================
// TITLE CONFIGURATION - VERSIÓN CON i18n
// ===========================

const TITLE_CONFIG = {
  deviannt: {
    titleKey: 'title.deviannt',
    subtitleKey: 'subtitle.deviannt',
    showDescription: true,
    descriptionKey: 'desc.deviannt',
    indentedKey: 'indented.about.services'
  },
  projects: {
    titleKey: 'title.projects',
    showDescription: true,
    descriptionKey: ''
  },
  blog: {
    titleKey: 'title.blog',
    subtitleKey: 'subtitle.blog',
    showDescription: true,
    descriptionKey: 'desc.blog'
  },
  contact: {
    titleKey: 'title.contact',
    subtitleKey: 'subtitle.contact',
    showDescription: false,
    descriptionKey: ''
  }
};

// ===========================
// GESTOR DE TYPING
// ===========================
const typingManager = {
  currentTimeout: null,
  isAnimating: false,
  targetElement: null,
  fullText: '',
  speed: 72,
  
  stopCurrentAnimation() {
    if (this.currentTimeout) {
      clearTimeout(this.currentTimeout);
      this.currentTimeout = null;
    }
    this.isAnimating = false;
  },
  
  setTextInstantly(element, text) {
    if (!element) return;
    element.textContent = text;
    this.isAnimating = false;
  },
  
  startTyping(element, text) {
    if (!element) return;
    this.stopCurrentAnimation();
    this.targetElement = element;
    this.fullText = text;
    element.textContent = '';
    this.isAnimating = true;
    this.typeNextCharacter(0);
  },
  
  typeNextCharacter(index) {
    if (!this.isAnimating || !this.targetElement) return;
    if (index >= this.fullText.length) {
      this.isAnimating = false;
      return;
    }
    this.targetElement.textContent += this.fullText.charAt(index);
    this.currentTimeout = setTimeout(() => {
      this.typeNextCharacter(index + 1);
    }, this.speed);
  }
};

// ===========================
// FUNCIONES DEL TITLE MANAGER
// ===========================

function getTitleConfig(section) {
  return TITLE_CONFIG[section] || TITLE_CONFIG.deviannt;
}

function updateTitle(section) {
  const config = getTitleConfig(section);
  const titleElement = $('.title-select span');
  const subtitleElement = $('.subtitle .typed-text');
  const descriptionElements = $$('.description');
  const indentedDescriptionEl = $('.description--indented');
  
  typingManager.stopCurrentAnimation();
  
  if (titleElement) {
    const titleText = i18n.getText(config.titleKey);
    titleElement.textContent = titleText;
    const parent = titleElement.parentElement;
    parent.classList.remove("animate");
    void parent.offsetWidth;
    parent.classList.add("animate");
  }
  
  if (subtitleElement) {
    let newSubtitle;
    if (section === "projects") {
      const projectData = window.projectSelector?.getCurrentProjectData?.();
      if (projectData && projectData.subtitle) {
        newSubtitle = projectData.subtitle;
      } else {
        newSubtitle = i18n.getText('subtitle.projects');
      }
    } else {
      newSubtitle = i18n.getText(config.subtitleKey);
    }
    
    if (section === "projects") {
      typingManager.setTextInstantly(subtitleElement, newSubtitle);
    } else {
      setTimeout(() => {
        typingManager.startTyping(subtitleElement, newSubtitle);
      }, 20);
    }
  }
  
  descriptionElements.forEach((el, index) => {
    if (config.showDescription) {
      el.style.display = 'block';
      if (index === 0) {
        if (section === "projects") {
          const projectData = window.projectSelector?.getCurrentProjectData?.();
          el.textContent = projectData ? projectData.description : i18n.getText('desc.projects');
        } else {
          el.innerHTML = i18n.getText(config.descriptionKey);
        }
      } else if (index === 1) {
        if (section === "blog") {
          el.style.display = 'none';
        } else if (section !== "contact") {
          el.style.display = 'block';
          // ─── AQUÍ ESTÁ EL CAMBIO ───
          if (section === "deviannt") {
            el.innerHTML = i18n.getText('indented.about.services');
          }
          // ─────────────────────────
        } else {
          el.style.display = 'none';
        }
      }
    } else {
      el.style.display = 'none';
    }
  });

  // Blog: construir layout de 2 columnas con feed
  if (section === "blog") {
    _ensureBlogTwoColLayout(false);
    if (window.blogFeed) {
      setTimeout(() => window.blogFeed.load(), 150);
    }
  }

  if (section !== "blog") {
    _teardownBlogTwoColLayout();
  }

  if (indentedDescriptionEl && section !== "blog" && section !== "contact") {
    if (section !== "projects") {
      indentedDescriptionEl.style.display = 'block';
      indentedDescriptionEl.style.paddingLeft = '';
      indentedDescriptionEl.style.textAlign = '';
      indentedDescriptionEl.style.marginLeft = '';
      indentedDescriptionEl.style.marginRight = '';
    }
  }
}

// ===========================
// BLOG 2-COLUMN LAYOUT
// ===========================

let _blogOriginalNodes = null;
let _blogTwoColEl = null;

function _ensureBlogTwoColLayout(repositionCard = true) {
  const inner = $('.content-stack-inner');
  if (!inner) return;

  if (_blogTwoColEl && inner.contains(_blogTwoColEl)) {
    _blogTwoColEl.style.display = 'flex';
    const feedContainer = _blogTwoColEl.querySelector('.blog-feed-container');
    if (feedContainer) feedContainer.style.display = 'block';
    if (repositionCard) _repositionSocialCard();
    return;
  }

  _blogOriginalNodes = Array.from(inner.childNodes).map(n => ({
    node: n,
    nextSibling: n.nextSibling
  }));

  const titleEl      = inner.querySelector('.title-select');
  const subtitleEl   = inner.querySelector('.subtitle');
  const descEl       = inner.querySelector('.description:not(.description--indented)');
  const indentedEl   = inner.querySelector('.description--indented');

  const twoCol = document.createElement('div');
  twoCol.className = 'blog-two-col';
  _blogTwoColEl = twoCol;

  const leftCol = document.createElement('div');
  leftCol.className = 'blog-left-col';

  if (titleEl)    leftCol.appendChild(titleEl);
  if (subtitleEl) leftCol.appendChild(subtitleEl);
  if (descEl)     leftCol.appendChild(descEl);
  if (indentedEl) { indentedEl.style.display = 'none'; leftCol.appendChild(indentedEl); }

  // Live indicator
  const liveIndicator = document.createElement('div');
  liveIndicator.className = 'blog-live-indicator';
  liveIndicator.innerHTML = i18n.getText('blog.live.indicator');
  leftCol.appendChild(liveIndicator);

  // CTA button
  const ctaBtn = document.createElement('a');
  ctaBtn.className = 'blog-cta-btn';
  ctaBtn.href = 'https://blog.deviannt.com';
  ctaBtn.target = '_blank';
  ctaBtn.rel = 'noopener noreferrer';
  ctaBtn.innerHTML = i18n.getText('blog.cta');
  leftCol.appendChild(ctaBtn);

  // Anchor para el social card
  const socialAnchor = document.createElement('div');
  socialAnchor.className = 'blog-social-anchor';
  socialAnchor.id = 'blog-social-anchor';
  leftCol.appendChild(socialAnchor);

  const rightCol = document.createElement('div');
  rightCol.className = 'blog-right-col';

  const feedContainer = document.createElement('div');
  feedContainer.className = 'blog-feed-container';
  rightCol.appendChild(feedContainer);

  twoCol.appendChild(leftCol);
  twoCol.appendChild(rightCol);

  inner.innerHTML = '';
  inner.appendChild(twoCol);

  if (repositionCard) _repositionSocialCard();
}

function _teardownBlogTwoColLayout() {
  if (!_blogTwoColEl) return;
  const inner = $('.content-stack-inner');
  if (!inner) return;

  const titleEl    = _blogTwoColEl.querySelector('.title-select');
  const subtitleEl = _blogTwoColEl.querySelector('.subtitle');
  const descEl     = _blogTwoColEl.querySelector('.description:not(.description--indented)');
  const indentedEl = _blogTwoColEl.querySelector('.description--indented');

  _restoreSocialCard();

  inner.innerHTML = '';

  if (titleEl)    inner.appendChild(titleEl);
  if (subtitleEl) inner.appendChild(subtitleEl);
  if (descEl)     inner.appendChild(descEl);
  if (indentedEl) {
    indentedEl.style.display = '';
    inner.appendChild(indentedEl);
  }

  _blogTwoColEl = null;
  _blogOriginalNodes = null;

  if (window.blogFeed) window.blogFeed.reset();
}

function _repositionSocialCard() {
  const anchor = document.getElementById('blog-social-anchor');
  const socialWrapper = document.querySelector('.social-wrapper');
  if (!anchor || !socialWrapper) return;
  if (window.innerWidth <= 768) return;

  if (!socialWrapper._blogOriginalParent) {
    socialWrapper._blogOriginalParent = socialWrapper.parentNode;
    socialWrapper._blogOriginalNextSibling = socialWrapper.nextSibling;
  }

  anchor.appendChild(socialWrapper);
  socialWrapper.style.position = 'absolute';
  socialWrapper.style.bottom = '0';
  socialWrapper.style.left = '0';
  socialWrapper.style.top = '';
  socialWrapper.style.right = '';
  socialWrapper.style.width = '250px';
  socialWrapper.style.height = '80px';
  socialWrapper.style.opacity = '1';
  socialWrapper.style.pointerEvents = 'auto';
  socialWrapper.style.animation = 'float-natural 6s ease-in-out infinite';
}

function _restoreSocialCard() {
  const socialWrapper = document.querySelector('.social-wrapper');
  if (!socialWrapper || !socialWrapper._blogOriginalParent) return;

  const parent = socialWrapper._blogOriginalParent;
  const next   = socialWrapper._blogOriginalNextSibling;

  if (next && next.parentNode === parent) {
    parent.insertBefore(socialWrapper, next);
  } else {
    parent.appendChild(socialWrapper);
  }

  delete socialWrapper._blogOriginalParent;
  delete socialWrapper._blogOriginalNextSibling;
}

function stopTypingAnimation() {
  typingManager.stopCurrentAnimation();
}

// ===========================
// INICIALIZACIÓN
// ===========================

document.addEventListener('DOMContentLoaded', () => {
  window.titleManager = {
    getConfig: getTitleConfig,
    update: updateTitle,
    config: TITLE_CONFIG,
    stopTyping: stopTypingAnimation,
    _ensureBlogTwoColLayout: _ensureBlogTwoColLayout,
    _repositionSocialCard: _repositionSocialCard,
    _restoreSocialCard: _restoreSocialCard,
    _teardownBlogTwoColLayout: _teardownBlogTwoColLayout
  };
  
  if (window.i18n) {
    window.i18n.onChange(() => {
      const activeLink = $('.navbar a.active');
      const section = activeLink ? activeLink.dataset.title : 'deviannt';
      updateTitle(section);
      if (section === 'projects' && window.projectSelector) {
        window.projectSelector.forceUpdate();
      }
      if (section === 'blog' && window.blogFeed) {
        window.blogFeed.reset();
        setTimeout(() => window.blogFeed.load(), 100);
      }
    });
  }

  const activeLink = $('.navbar a.active');
  updateTitle(activeLink ? activeLink.dataset.title : 'deviannt');
});
</file>

<file path="js/waves.js">
// ==========================================================================
// WAVES.JS - Efecto de ondas de fondo - DARK THEME
// ==========================================================================

const Waves = (function() {
  'use strict';

  // ==========================================================================
  // CONFIGURACIÓN
  // ==========================================================================
  const CONFIG = {
    GRID_SIZE: 14,
    SPEED: 0.0012,
    WAVE_RADIUS: 1.5,
    MOUSE_DECAY: 0.02,
    MAX_PERTURBATIONS: 20,
    COLORS: {
      // Dark theme: fondo negro → azul oscuro profundo
      BASE_BLUE: [37, 99, 235],   // #2563EB
      WHITE:     [11, 18, 32]     // #0B1220 (bg-deep)
    },
    ANIMATION: {
      START_OFFSET: 800,
      FADE_POWER_BR: 2,
      FADE_POWER_TL: 5
    }
  };

  // ==========================================================================
  // ESTADO PRIVADO
  // ==========================================================================
  let state = {
    canvasBR: null,
    ctxBR: null,
    canvasTL: null,
    ctxTL: null,
    perturbationsBR: [],
    perturbationsTL: [],
    startBR: 0,
    startTL: 0,
    animationFrame: null,
    isInitialized: false,
    isVisible: true,
    handlers: null
  };

  // ==========================================================================
  // MÉTODOS PRIVADOS
  // ==========================================================================
  function setupCanvas() {
    state.canvasBR = document.getElementById("bg-wave");
    state.canvasTL = document.getElementById("bg-wave-tl");

    if (!state.canvasBR || !state.canvasTL) return false;

    state.ctxBR = state.canvasBR.getContext("2d");
    state.ctxTL = state.canvasTL.getContext("2d");

    state.startBR = performance.now();
    state.startTL = performance.now() + CONFIG.ANIMATION.START_OFFSET;

    return true;
  }

  function setupEvents() {
    if (!state.canvasBR || !state.canvasTL) return;

    const handlers = {
      br: (e) => handleMouseMove('br', e),
      tl: (e) => handleMouseMove('tl', e)
    };

    state.canvasBR.addEventListener("mousemove", handlers.br);
    state.canvasBR.addEventListener("mousedown", handlers.br);
    state.canvasTL.addEventListener("mousemove", handlers.tl);
    state.canvasTL.addEventListener("mousedown", handlers.tl);

    state.handlers = handlers;
  }

  function handleMouseMove(origin, e) {
    const rect = e.currentTarget.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    const perturbation = { x, y, strength: 1.0 };

    if (origin === "br") {
      state.perturbationsBR.push(perturbation);
      if (state.perturbationsBR.length > CONFIG.MAX_PERTURBATIONS) {
        state.perturbationsBR.shift();
      }
    } else {
      state.perturbationsTL.push(perturbation);
      if (state.perturbationsTL.length > CONFIG.MAX_PERTURBATIONS) {
        state.perturbationsTL.shift();
      }
    }
  }

  function resizeCanvas(canvas, ctx) {
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    canvas.width  = rect.width  * dpr;
    canvas.height = rect.height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function resizeAll() {
    if (!state.ctxBR || !state.ctxTL) return;
    resizeCanvas(state.canvasBR, state.ctxBR);
    resizeCanvas(state.canvasTL, state.ctxTL);
  }

  function lerp(a, b, t) { return a + (b - a) * t; }

  function clamp(v, min = 0, max = 1) { return Math.min(max, Math.max(min, v)); }

  function drawWave(ctx, canvas, now, origin) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const start        = origin === "br" ? state.startBR : state.startTL;
    const phase        = (now - start) * CONFIG.SPEED;
    const perturbations = origin === "br" ? state.perturbationsBR : state.perturbationsTL;

    const cols    = Math.ceil(canvas.width  / CONFIG.GRID_SIZE);
    const rows    = Math.ceil(canvas.height / CONFIG.GRID_SIZE);
    const maxDist = Math.hypot(cols, rows);

    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        const px = x * CONFIG.GRID_SIZE;
        const py = y * CONFIG.GRID_SIZE;

        const dxBase   = origin === "br" ? cols - x : x;
        const dyBase   = origin === "br" ? rows - y : y;
        const distBase = Math.hypot(dxBase, dyBase) / maxDist;

        const delay = distBase * 4.2;
        let wave = Math.sin(phase - delay);
        wave = Math.pow(wave * 0.5 + 0.5, 2);
        let scale = 1 - wave * 0.6 * CONFIG.WAVE_RADIUS;

        for (let i = 0; i < perturbations.length; i++) {
          const p    = perturbations[i];
          const dx   = x * CONFIG.GRID_SIZE - p.x;
          const dy   = y * CONFIG.GRID_SIZE - p.y;
          const dist = Math.hypot(dx, dy) / 200;
          scale -= (Math.cos(dist * Math.PI) * 0.3 * p.strength) || 0;
        }

        const fadePower = origin === "br" ? CONFIG.ANIMATION.FADE_POWER_BR : CONFIG.ANIMATION.FADE_POWER_TL;
        let fade;
        if (origin === "br") {
          fade = clamp(Math.pow(y / rows, fadePower));
        } else {
          fade = clamp(Math.pow((rows - y) / rows, fadePower));
        }

        const [r, g, b] = [
          lerp(CONFIG.COLORS.WHITE[0], CONFIG.COLORS.BASE_BLUE[0], fade),
          lerp(CONFIG.COLORS.WHITE[1], CONFIG.COLORS.BASE_BLUE[1], fade),
          lerp(CONFIG.COLORS.WHITE[2], CONFIG.COLORS.BASE_BLUE[2], fade)
        ];

        ctx.fillStyle = `rgb(${Math.round(r)},${Math.round(g)},${Math.round(b)})`;
        const offset = (CONFIG.GRID_SIZE - CONFIG.GRID_SIZE * scale) / 2;
        ctx.fillRect(px + offset, py + offset, CONFIG.GRID_SIZE * scale, CONFIG.GRID_SIZE * scale);
      }
    }

    // Decaimiento de perturbaciones
    let i = perturbations.length;
    while (i--) {
      perturbations[i].strength -= CONFIG.MOUSE_DECAY;
      if (perturbations[i].strength <= 0) {
        perturbations.splice(i, 1);
      }
    }
  }

  function animate(now) {
    if (!state.ctxBR || !state.ctxTL) return;

    if (state.isVisible) {
      drawWave(state.ctxBR, state.canvasBR, now, "br");
      drawWave(state.ctxTL, state.canvasTL, now, "tl");
    }

    state.animationFrame = requestAnimationFrame(animate);
  }

  function handleVisibilityChange() {
    state.isVisible = !document.hidden;
  }

  // ==========================================================================
  // API PÚBLICA
  // ==========================================================================
  return {
    init() {
      if (state.isInitialized) return;
      if (!setupCanvas()) return;

      setupEvents();
      resizeAll();
      window.addEventListener("resize", resizeAll);
      document.addEventListener("visibilitychange", handleVisibilityChange);

      // prefers-reduced-motion: las olas son puramente decorativas, así
      // que en vez de correr el loop de rAF para siempre, pintamos un
      // único frame estático (queda el fondo con textura, sin el efecto
      // de ola perpetuo) y no arrancamos la animación.
      const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        drawWave(state.ctxBR, state.canvasBR, state.startBR, "br");
        drawWave(state.ctxTL, state.canvasTL, state.startTL, "tl");
        state.isInitialized = true;
        return;
      }

      state.animationFrame = requestAnimationFrame(animate);
      state.isInitialized  = true;
    },

    destroy() {
      if (state.animationFrame) {
        cancelAnimationFrame(state.animationFrame);
      }

      if (state.handlers) {
        state.canvasBR?.removeEventListener("mousemove", state.handlers.br);
        state.canvasBR?.removeEventListener("mousedown", state.handlers.br);
        state.canvasTL?.removeEventListener("mousemove", state.handlers.tl);
        state.canvasTL?.removeEventListener("mousedown", state.handlers.tl);
      }

      window.removeEventListener("resize", resizeAll);
      document.removeEventListener("visibilitychange", handleVisibilityChange);
      state.isInitialized = false;
    }
  };
})();

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    window.waves = Waves;
    window.waves.init();
  });
} else {
  window.waves = Waves;
  window.waves.init();
}
</file>

<file path="404.html">
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 — devianntsec</title>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'JetBrains Mono', 'SF Mono', Monaco, monospace;
      background: #060910;
      color: #e2e8f0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
    }

    /* Grid background */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(59,130,246,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59,130,246,0.04) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    .stage {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 4rem 2rem 5rem;
      width: 100%;
      max-width: 640px;
    }

    /* ── 404 glitch number ── */
    .num-wrap {
      position: relative;
      display: inline-block;
      line-height: 1;
      margin-bottom: 2.5rem;
    }

    .num {
      font-size: clamp(5.5rem, 18vw, 13rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(59,130,246,0.45);
      position: relative;
      display: block;
      animation: flicker 7s infinite;
      user-select: none;
    }

    .num::before,
    .num::after {
      content: attr(data-text);
      position: absolute;
      inset: 0;
      font-family: inherit;
      font-size: inherit;
      font-weight: inherit;
      letter-spacing: inherit;
      opacity: 0;
    }

    .num::before {
      -webkit-text-stroke: 1.5px #EF4444;
      color: transparent;
      clip-path: polygon(0 20%, 100% 20%, 100% 38%, 0 38%);
      transform: translateX(-3px);
      animation: gr 5s infinite;
    }

    .num::after {
      -webkit-text-stroke: 1.5px #3B82F6;
      color: transparent;
      clip-path: polygon(0 60%, 100% 60%, 100% 80%, 0 80%);
      transform: translateX(3px);
      animation: gb 5s infinite 0.12s;
    }

    /* scanlines overlay */
    .scanlines {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0,0,0,0.12) 2px,
        rgba(0,0,0,0.12) 4px
      );
      pointer-events: none;
      animation: scan 10s linear infinite;
    }

    /* corner brackets */
    .corner {
      position: absolute;
      width: 18px;
      height: 18px;
      border-color: rgba(59,130,246,0.48);
      border-style: solid;
    }
    .corner.tl { top: -5px;    left: -5px;   border-width: 2px 0 0 2px; }
    .corner.tr { top: -5px;    right: -5px;  border-width: 2px 2px 0 0; }
    .corner.bl { bottom: -5px; left: -5px;   border-width: 0 0 2px 2px; }
    .corner.br { bottom: -5px; right: -5px;  border-width: 0 2px 2px 0; }

    /* ── divider ── */
    .divider {
      width: clamp(140px, 30vw, 340px);
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(59,130,246,0.28), transparent);
      margin-bottom: 1.6rem;
    }

    /* ── message lines ── */
    .msg {
      display: flex;
      flex-direction: column;
      gap: 0.28rem;
      margin-bottom: 2.6rem;
    }

    .line {
      font-size: clamp(0.74rem, 1.8vw, 0.92rem);
      font-weight: 400;
      letter-spacing: 0.02em;
      color: #475569;
      opacity: 0;
      animation: fadein 0.55s ease forwards;
    }

    .line:nth-child(1) { animation-delay: 0.4s; }
    .line:nth-child(2) {
      animation-delay: 0.75s;
      color: #60A5FA;
      font-style: italic;
    }

    .prefix {
      color: #3B82F6;
      opacity: 0.55;
      font-weight: 300;
      margin-right: 0.4em;
    }

    .cursor {
      display: inline-block;
      width: 7px;
      height: 0.9em;
      background: #3B82F6;
      vertical-align: middle;
      margin-left: 3px;
      opacity: 0;
      animation: blink 1s step-end infinite;
      animation-delay: 1.4s;
      animation-fill-mode: forwards;
    }

    /* ── buttons ── */
    .actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
      opacity: 0;
      animation: fadein 0.55s ease 1.1s forwards;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: #475569;
      text-decoration: none;
      padding: 0.5rem 1.15rem;
      border: 1px solid rgba(59,130,246,0.18);
      background: rgba(59,130,246,0.04);
      position: relative;
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      white-space: nowrap;
    }

    .btn::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: transparent;
      transition: background 0.2s ease;
    }

    .btn:hover {
      color: #60A5FA;
      border-color: rgba(59,130,246,0.42);
      background: rgba(59,130,246,0.08);
    }

    .btn:hover::before { background: #3B82F6; }

    .btn-arrow {
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .btn:hover .btn-arrow { transform: translateX(-3px); }

    /* language hidden by default, JS shows one set */
    [data-lang] { display: none; }
    [data-lang].active { display: inline-flex; }
    .msg [data-lang] { display: none; }
    .msg [data-lang].active { display: block; }

    /* ── animations ── */
    @keyframes fadein {
      from { opacity: 0; transform: translateY(5px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }
    @keyframes flicker {
      0%, 94%, 100% { opacity: 1; }
      95%  { opacity: 0.75; }
      96%  { opacity: 1; }
      97%  { opacity: 0.6; }
      98%  { opacity: 1; }
    }
    @keyframes gr {
      0%, 88%, 100% { opacity: 0; transform: translateX(0); }
      89% { opacity: 0.9; transform: translateX(-4px); clip-path: polygon(0 15%, 100% 15%, 100% 33%, 0 33%); }
      91% { opacity: 0.6; transform: translateX(3px);  clip-path: polygon(0 58%, 100% 58%, 100% 76%, 0 76%); }
      93% { opacity: 0; }
    }
    @keyframes gb {
      0%, 90%, 100% { opacity: 0; transform: translateX(0); }
      91% { opacity: 0.9; transform: translateX(4px);  clip-path: polygon(0 63%, 100% 63%, 100% 82%, 0 82%); }
      93% { opacity: 0.6; transform: translateX(-3px); clip-path: polygon(0 28%, 100% 28%, 100% 46%, 0 46%); }
      95% { opacity: 0; }
    }
    @keyframes scan {
      from { background-position: 0 0; }
      to   { background-position: 0 120px; }
    }

    @media (max-width: 480px) {
      .actions { flex-direction: column; align-items: center; }
      .btn { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>
  <div class="stage">

    <!-- glitch 404 -->
    <div class="num-wrap">
      <div class="corner tl"></div>
      <div class="corner tr"></div>
      <div class="corner bl"></div>
      <div class="corner br"></div>
      <div class="scanlines"></div>
      <span class="num" data-text="404">404</span>
    </div>

    <div class="divider"></div>

    <!-- bilingual message -->
    <div class="msg">
      <div class="line" data-lang="en">
        <span class="prefix">//</span>A hacker has hijacked this page.
      </div>
      <div class="line" data-lang="en">
        <span class="prefix">//</span>Just kidding. You probably mistyped something.<span class="cursor"></span>
      </div>

      <div class="line" data-lang="es">
        <span class="prefix">//</span>Un hacker ha secuestrado esta página.
      </div>
      <div class="line" data-lang="es">
        <span class="prefix">//</span>Es broma. Solo cometiste un typo.<span class="cursor"></span>
      </div>
    </div>

    <!-- buttons -->
    <div class="actions">
      <a class="btn" data-lang="en" href="https://deviannt.com/">
        <span class="btn-arrow">←</span>
        <span>home</span>
      </a>
      <a class="btn" data-lang="en" href="https://blog.deviannt.com/">
        <span class="btn-arrow">←</span>
        <span>blog</span>
      </a>

      <a class="btn" data-lang="es" href="https://deviannt.com/">
        <span class="btn-arrow">←</span>
        <span>inicio</span>
      </a>
      <a class="btn" data-lang="es" href="https://blog.deviannt.com/es/">
        <span class="btn-arrow">←</span>
        <span>blog</span>
      </a>
    </div>

  </div>

  <script>
  (function () {
    // Detect language: URL path first, then browser preference
    var path = window.location.pathname;
    var lang = 'en';

    if (path.startsWith('/es/') || path === '/es') {
      lang = 'es';
    } else {
      var nav = navigator.language || navigator.userLanguage || '';
      if (nav.toLowerCase().startsWith('es')) lang = 'es';
    }

    document.documentElement.setAttribute('lang', lang);

    // Show elements for the detected language
    document.querySelectorAll('[data-lang]').forEach(function (el) {
      if (el.getAttribute('data-lang') === lang) {
        el.classList.add('active');
      }
    });
  })();
  </script>
</body>
